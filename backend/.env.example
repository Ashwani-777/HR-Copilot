# --- Server ---
PORT=4100
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# --- Data stores ---
# Homebrew/Postgres.app: the superuser is your OS user, no password.
# `sed "s/YOUR_USER/$USER/" .env.example > .env` fills it in.
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/hr_copilot?schema=public
# Optional: tests default to the same URL with the database renamed to hr_copilot_test
TEST_DATABASE_URL=postgresql://YOUR_USER@localhost:5432/hr_copilot_test?schema=public
# DB index 5 + BullMQ prefix "hrc" so this app never collides with other projects on the same Redis
REDIS_URL=redis://localhost:6379/5
BULLMQ_PREFIX=hrc

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- AI providers ---
# mock = deterministic, offline, no keys (default). openai = any OpenAI-compatible API. anthropic = Claude.
LLM_PROVIDER=mock
# mock | openai   (embeddings must be 1536-dimensional: Chunk.embedding is vector(1536))
EMBEDDING_PROVIDER=mock

# OpenAI-compatible (OpenAI, Groq, Ollama, ...). Leave OPENAI_BASE_URL empty for api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Claude). Embeddings still come from EMBEDDING_PROVIDER.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Mock provider: delay between streamed words (ms). 0 in tests.
MOCK_STREAM_DELAY_MS=15
